# Maintainer: YOUR NAME <you@example.org>
# The package is published to the AUR by hand; scripts/aur-update.sh bumps pkgver and sha256sums
# for a new release (BUILD-026, raba/shale#337).
pkgname=shale-bin
pkgver=0.6.0
pkgrel=1
pkgdesc='Native notes app: a vault is a plain folder of Markdown files (prebuilt release)'
arch=('x86_64')
url='https://github.com/rabalyn/shale'
license=('GPL-3.0-or-later')
# linked: glibc, gcc-libs, alsa-lib; loaded when the window opens (winit/glutin/xkbcommon
# dlopen them): Wayland, X11, xkbcommon and OpenGL through libglvnd
depends=('glibc' 'gcc-libs' 'alsa-lib' 'libxkbcommon' 'wayland' 'libx11' 'libxcursor'
         'libxrandr' 'libxi' 'libglvnd')
optdepends=('git: git sync of a vault'
            'git-lfs: media files (audio, video) in git sync'
            'curl: CalDAV and git sync over HTTPS'
            'ffmpeg: playing videos in notes and recording clips'
            'gnupg: signed and encrypted mail'
            'pandoc: importing Word (.docx) files as notes'
            'libsecret: secret-tool, to keep passwords in the system keyring')
provides=('shale')
conflicts=('shale')
source=("${pkgname}-${pkgver}.tar.gz::https://github.com/rabalyn/shale/releases/download/v${pkgver}/shale-${pkgver}-linux-x86_64.tar.gz")
sha256sums=('022cb03db646606afbc1addf64ac8735855c78b9be0620c8503314e2ad01c770')

package() {
  cd "${srcdir}/shale"

  install -Dm755 shale "${pkgdir}/usr/bin/shale"
  install -Dm644 shale.desktop "${pkgdir}/usr/share/applications/shale.desktop"
  install -Dm644 shale.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/shale.svg"

  # the PNG icons are in the download from the release after 0.5.1 on
  local png size
  for png in assets/icon/shale-*.png; do
    [ -e "${png}" ] || continue
    size="${png##*/shale-}"
    size="${size%.png}"
    install -Dm644 "${png}" "${pkgdir}/usr/share/icons/hicolor/${size}x${size}/apps/shale.png"
  done

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md CHANGELOG.md -t "${pkgdir}/usr/share/doc/shale"
  if [ -d docs ]; then
    cp -r docs "${pkgdir}/usr/share/doc/shale/docs"
  fi
  find "${pkgdir}/usr/share/doc/shale" -type d -exec chmod 755 {} +
  find "${pkgdir}/usr/share/doc/shale" -type f -exec chmod 644 {} +
}
