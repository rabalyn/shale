pkgbase = shale-bin
	pkgdesc = Native notes app: a vault is a plain folder of Markdown files (prebuilt release)
	pkgver = 0.5.1
	pkgrel = 1
	url = https://github.com/rabalyn/shale
	arch = x86_64
	license = MIT
	depends = glibc
	depends = gcc-libs
	depends = alsa-lib
	depends = libxkbcommon
	depends = wayland
	depends = libx11
	depends = libxcursor
	depends = libxrandr
	depends = libxi
	depends = libglvnd
	optdepends = git: git sync of a vault
	optdepends = git-lfs: media files (audio, video) in git sync
	optdepends = curl: CalDAV and git sync over HTTPS
	optdepends = ffmpeg: playing videos in notes and recording clips
	optdepends = gnupg: signed and encrypted mail
	optdepends = pandoc: importing Word (.docx) files as notes
	optdepends = libsecret: secret-tool, to keep passwords in the system keyring
	optdepends = mesa: OpenGL driver for AMD and Intel graphics
	optdepends = nvidia-utils: OpenGL driver for NVIDIA graphics
	provides = shale
	conflicts = shale
	source = shale-bin-0.5.1.tar.gz::https://github.com/rabalyn/shale/releases/download/v0.5.1/shale-0.5.1-linux-x86_64.tar.gz
