#!/bin/sh
# A pretend `secret-tool` for tests (the Secret Service of Linux): the entries are files in the
# folder $FAKE_SECRET_DIR, named by a checksum of the attributes. It knows what src/secrets.rs
# calls: search (the probe), store, lookup, clear. Never installed anywhere; tests put it first on PATH.
set -eu
dir=${FAKE_SECRET_DIR:?FAKE_SECRET_DIR is not set}
cmd=${1:-}
[ $# -gt 0 ] && shift
case $cmd in
  search) exit 0 ;;
  store)
    shift 2 # --label <text>
    key=$(printf '%s\n' "$@" | cksum | cut -d ' ' -f 1)
    cat > "$dir/$key"
    ;;
  lookup)
    key=$(printf '%s\n' "$@" | cksum | cut -d ' ' -f 1)
    [ -f "$dir/$key" ] || exit 1
    cat "$dir/$key"
    ;;
  clear)
    key=$(printf '%s\n' "$@" | cksum | cut -d ' ' -f 1)
    rm -f "$dir/$key"
    ;;
  *) exit 2 ;;
esac
