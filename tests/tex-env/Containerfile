# TeX Live for Shale's LaTeX export tests (TEX-020, ADR-0019): LuaLaTeX and biber, installed from a
# repository the managed install uses too (the current TeX Live, ADR-0020), so the image is NOT the same
# every time it is built: it records the TeX Live year and the date in /etc/shale-tex-build. The packages are the list of
# assets/tex/packages.txt; the templates are not part of the image (tests/tex-env/README.md).
FROM docker.io/library/debian:bookworm-20260112-slim

ARG TL_REPO=https://mirror.ctan.org/systems/texlive/tlnet

RUN apt-get update \
 && apt-get install -y --no-install-recommends perl wget ca-certificates xz-utils \
 && rm -rf /var/lib/apt/lists/*

# the TeX Live binaries of the machine the image is built on: the Forgejo runner is arm64, a
# development machine often x86_64 (#289)
COPY texlive.profile /tmp/texlive.profile
RUN case "$(dpkg --print-architecture)" in \
      amd64) platform=x86_64-linux ;; \
      arm64) platform=aarch64-linux ;; \
      *) echo "no TeX Live binaries chosen for $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
 && sed -i "s/^binary_.* 1\$/binary_$platform 1/" /tmp/texlive.profile \
 && grep -qx "binary_$platform 1" /tmp/texlive.profile \
 && mkdir /tmp/install-tl \
 && wget -q -O - "$TL_REPO/install-tl-unx.tar.gz" | tar xz -C /tmp/install-tl --strip-components=1 \
 && /tmp/install-tl/install-tl --no-interaction --profile /tmp/texlive.profile --repository "$TL_REPO" \
 && rm -rf /tmp/install-tl
# only the folder of this machine's platform exists
ENV PATH=/opt/texlive/bin/aarch64-linux:/opt/texlive/bin/x86_64-linux:$PATH

COPY packages.txt /tmp/packages.txt
RUN sed 's/#.*//' /tmp/packages.txt | xargs tlmgr --repository "$TL_REPO" install

# which TeX Live this image is: year, repository, build date (`tex-env.sh status` prints it)
RUN echo "TeX Live $(head -n 1 /opt/texlive/release-texlive.txt | sed 's/.*version //') from $TL_REPO, built $(date -u +%Y-%m-%d)" > /etc/shale-tex-build

WORKDIR /work
